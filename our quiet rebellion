
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>हम बोलेंगे • Sarla Chopra DAV</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700&family=Inter:wght@400;500;600&display=swap');
        
        body { 
            font-family: 'Inter', system_ui, sans-serif; 
            background: linear-gradient(to bottom, #F9F4EB, #F0E6D9);
        }
        .heading-font { 
            font-family: 'Playfair Display', sans-serif; 
        }

        .hero-bg {
            background: linear-gradient(rgba(10, 25, 47, 0.88), rgba(15, 35, 65, 0.92)), 
                        url('https://picsum.photos/id/1015/2000/1200') center/cover no-repeat;
        }

        .section-beige {
            background: #F9F4EB;
        }
        .section-sand {
            background: #F5EDE4;
        }
        .section-peach {
            background: #FFF0E6;
        }

        .fade-in {
            opacity: 0;
            transform: translateY(30px);
            transition: all 0.8s ease-out;
        }
        .fade-in.visible {
            opacity: 1;
            transform: translateY(0);
        }

        .accordion-header {
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        }
        .accordion-content {
            max-height: 0;
            overflow: hidden;
            transition: max-height 0.5s cubic-bezier(0.4, 0.0, 0.2, 1);
        }
        .accordion-open .accordion-content {
            max-height: 800px;
        }

        .nav-link {
            position: relative;
        }
        .nav-link:after {
            content: '';
            position: absolute;
            width: 0;
            height: 2px;
            bottom: -2px;
            left: 0;
            background-color: #E07A5F;
            transition: width 0.3s ease;
        }
        .nav-link:hover:after {
            width: 100%;
        }

        .demand-card {
            transition: all 0.4s ease;
        }
        .demand-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 20px 25px -5px rgb(0 0 0 / 0.1), 0 8px 10px -6px rgb(0 0 0 / 0.1);
        }
    </style>
</head>
<body class="text-[#2C2C2C]">

    <!-- NAV -->
    <nav class="bg-[#0F2A4A] text-white py-6 sticky top-0 z-50 shadow-lg">
        <div class="max-w-7xl mx-auto px-6 flex justify-between items-center">
            <div class="flex items-center gap-3">
                <span class="text-4xl">🕊️</span>
                <div>
                    <span class="text-2xl font-bold tracking-tight">SARLA CHOPRA DAV</span>
                    <span class="block text-amber-200 text-sm tracking-widest">हम बोलेंगे</span>
                </div>
            </div>
            <div class="hidden md:flex gap-8 text-lg">
                <a href="#demands" class="nav-link text-white/90 hover:text-white">मांगें</a>
                <a href="#charter" class="nav-link text-white/90 hover:text-white">हमारा चार्टर</a>
            </div>
            <button onclick="document.getElementById('charter').scrollIntoView({ behavior: 'smooth' })" 
                    class="bg-[#E07A5F] hover:bg-[#D96B4F] px-8 py-4 rounded-2xl font-semibold transition-all active:scale-95 shadow-md">
                SIGN NOW
            </button>
        </div>
    </nav>

    <!-- HERO -->
    <header class="hero-bg h-screen flex items-center text-white relative">
        <div class="max-w-6xl mx-auto px-6 text-center fade-in">
            <p class="text-amber-200 tracking-[4px] text-lg mb-4">एकता • स्वाभिमान • परिवर्तन</p>
            <h1 class="heading-font text-6xl md:text-7xl leading-none font-bold tracking-tighter mb-6">
                THE BATCH THAT<br>CHOSE TO SPEAK
            </h1>
            <p class="max-w-2xl mx-auto text-xl md:text-2xl mb-12 text-white/90">
                हम अपनी मांगों के लिए शांतिपूर्ण तरीके से आवाज़ उठा रहे हैं
            </p>
            <button onclick="document.getElementById('charter').scrollIntoView({ behavior: 'smooth' })" 
                    class="bg-white text-[#0F2A4A] px-14 py-7 rounded-3xl font-semibold text-lg hover:shadow-2xl hover:scale-105 transition-all">
                JOIN THE MOVEMENT
            </button>
        </div>
    </header>

    <!-- COUNTER -->
    <div class="bg-white/80 backdrop-blur-md py-12 border-b border-[#E07A5F]/30">
        <div class="max-w-6xl mx-auto px-6 text-center fade-in">
            <div id="count" class="text-7xl md:text-8xl font-bold text-[#0F2A4A]">378</div>
            <p class="text-xl text-gray-700 mt-3">छात्रों ने हस्ताक्षर किए • Students Have Signed</p>
        </div>
    </div>

    <!-- DEMANDS -->
    <section id="demands" class="py-28 section-beige">
        <div class="max-w-6xl mx-auto px-6">
            <div class="text-center mb-16 fade-in">
                <h2 class="heading-font text-5xl font-bold text-[#0F2A4A]">हमारी मांगें</h2>
                <p class="text-[#E07A5F] mt-3 text-xl">Our Concerns • Our Hopes • Our Future</p>
            </div>

            <div class="max-w-4xl mx-auto space-y-8">

                <!-- Demand 1 -->
                <div class="demand-card border border-[#E8D9C0] rounded-3xl overflow-hidden bg-white shadow-sm fade-in" style="transition-delay: 100ms">
                    <div onclick="toggleAccordion(this)" class="accordion-header p-8 flex justify-between items-center cursor-pointer hover:bg-[#FFF8F0]">
                        <div class="flex items-center gap-5">
                            <span class="text-5xl">🏫</span>
                            <div>
                                <h3 class="text-2xl font-semibold">Better Infrastructure</h3>
                                <p class="text-gray-500">सुरक्षित और आधुनिक कक्षाएं</p>
                            </div>
                        </div>
                        <i class="fa-solid fa-chevron-down text-2xl text-[#E07A5F] transition-transform"></i>
                    </div>
                    <div class="accordion-content px-8 pb-8 text-gray-600">
                        <p>Broken desks, cracked walls, non-functional fans, poor lighting, and leaking roofs are daily realities. These issues directly affect our concentration, posture, and overall health.</p>
                        <ul class="list-disc pl-6 mt-4 space-y-2">
                            <li>Repair and replacement of damaged furniture</li>
                            <li>Proper ventilation and functional fans/lights in every classroom</li>
                            <li>Regular painting and maintenance of school buildings</li>
                            <li>Modern smart boards and better learning resources</li>
                        </ul>
                    </div>
                </div>

                <!-- Demand 2 -->
                <div class="demand-card border border-[#E8D9C0] rounded-3xl overflow-hidden bg-white shadow-sm fade-in" style="transition-delay: 200ms">
                    <div onclick="toggleAccordion(this)" class="accordion-header p-8 flex justify-between items-center cursor-pointer hover:bg-[#FFF8F0]">
                        <div class="flex items-center gap-5">
                            <span class="text-5xl">📝</span>
                            <div>
                                <h3 class="text-2xl font-semibold">Hindi Paper Incident</h3>
                                <p class="text-gray-500">परीक्षा की निष्पक्षता और पारदर्शिता</p>
                            </div>
                        </div>
                        <i class="fa-solid fa-chevron-down text-2xl text-[#E07A5F] transition-transform"></i>
                    </div>
                    <div class="accordion-content px-8 pb-8 text-gray-600">
                        <p>The recent Class 10 Hindi paper was confusing, out-of-syllabus, and caused huge stress among students. Many lost valuable time and marks due to printing errors and unclear questions.</p>
                        <ul class="list-disc pl-6 mt-4 space-y-2">
                            <li>Proper review of the paper by external experts</li>
                            <li>Grace marks or re-examination where needed</li>
                            <li>Assurance that future papers will be syllabus-aligned and error-free</li>
                        </ul>
                    </div>
                </div>

                <!-- Demand 3 -->
                <div class="demand-card border border-[#E8D9C0] rounded-3xl overflow-hidden bg-white shadow-sm fade-in" style="transition-delay: 300ms">
                    <div onclick="toggleAccordion(this)" class="accordion-header p-8 flex justify-between items-center cursor-pointer hover:bg-[#FFF8F0]">
                        <div class="flex items-center gap-5">
                            <span class="text-5xl">🚻</span>
                            <div>
                                <h3 class="text-2xl font-semibold">Clean Washrooms</h3>
                                <p class="text-gray-500">स्वच्छता और गरिमा</p>
                            </div>
                        </div>
                        <i class="fa-solid fa-chevron-down text-2xl text-[#E07A5F] transition-transform"></i>
                    </div>
                    <div class="accordion-content px-8 pb-8 text-gray-600">
                        <p>Basic hygiene should not be a luxury. Many washrooms are poorly maintained, lack soap, and have broken doors. This affects our health and dignity every single day.</p>
                        <ul class="list-disc pl-6 mt-4 space-y-2">
                            <li>Daily cleaning and sanitization schedule</li>
                            <li>Availability of soap, water, and sanitary pads</li>
                            <li>Separate and well-maintained facilities for boys and girls</li>
                        </ul>
                    </div>
                </div>

                <!-- Demand 4 -->
                <div class="demand-card border border-[#E8D9C0] rounded-3xl overflow-hidden bg-white shadow-sm fade-in" style="transition-delay: 400ms">
                    <div onclick="toggleAccordion(this)" class="accordion-header p-8 flex justify-between items-center cursor-pointer hover:bg-[#FFF8F0]">
                        <div class="flex items-center gap-5">
                            <span class="text-5xl">💧</span>
                            <div>
                                <h3 class="text-2xl font-semibold">Safe Drinking Water</h3>
                                <p class="text-gray-500">स्वच्छ और ठंडा पेयजल</p>
                            </div>
                        </div>
                        <i class="fa-solid fa-chevron-down text-2xl text-[#E07A5F] transition-transform"></i>
                    </div>
                    <div class="accordion-content px-8 pb-8 text-gray-600">
                        <p>Students often hesitate to drink water because of unclean dispensers and poor maintenance. Access to safe, cool drinking water is a basic need.</p>
                        <ul class="list-disc pl-6 mt-4 space-y-2">
                            <li>Regular cleaning and servicing of water coolers</li>
                            <li>Installation of more RO + UV purifiers</li>
                            <li>Daily monitoring and maintenance log</li>
                        </ul>
                    </div>
                </div>

                <!-- Demand 5 -->
                <div class="demand-card border border-[#E8D9C0] rounded-3xl overflow-hidden bg-white shadow-sm fade-in" style="transition-delay: 500ms">
                    <div onclick="toggleAccordion(this)" class="accordion-header p-8 flex justify-between items-center cursor-pointer hover:bg-[#FFF8F0]">
                        <div class="flex items-center gap-5">
                            <span class="text-5xl">🙏</span>
                            <div>
                                <h3 class="text-2xl font-semibold">Respectful Staff Behaviour</h3>
                                <p class="text-gray-500">सम्मानजनक और प्रोत्साहन भरा व्यवहार</p>
                            </div>
                        </div>
                        <i class="fa-solid fa-chevron-down text-2xl text-[#E07A5F] transition-transform"></i>
                    </div>
                    <div class="accordion-content px-8 pb-8 text-gray-600">
                        <p>We deeply respect our teachers. However, harsh language, public shaming, and lack of patience demotivate students and hurt mental health.</p>
                        <ul class="list-disc pl-6 mt-4 space-y-2">
                            <li>Encouraging and constructive feedback culture</li>
                            <li>Regular counselling and mental health awareness sessions</li>
                            <li>Training on positive communication</li>
                        </ul>
                    </div>
                </div>

                <!-- New Demand 6 -->
                <div class="demand-card border border-[#E8D9C0] rounded-3xl overflow-hidden bg-white shadow-sm fade-in" style="transition-delay: 600ms">
                    <div onclick="toggleAccordion(this)" class="accordion-header p-8 flex justify-between items-center cursor-pointer hover:bg-[#FFF8F0]">
                        <div class="flex items-center gap-5">
                            <span class="text-5xl">🏏</span>
                            <div>
                                <h3 class="text-2xl font-semibold">Sports &amp; Co-curricular Facilities</h3>
                                <p class="text-gray-500">शारीरिक और रचनात्मक विकास</p>
                            </div>
                        </div>
                        <i class="fa-solid fa-chevron-down text-2xl text-[#E07A5F] transition-transform"></i>
                    </div>
                    <div class="accordion-content px-8 pb-8 text-gray-600">
                        <p>Playgrounds are uneven, sports equipment is outdated or insufficient, and there is very little time given for co-curricular activities. We want holistic development, not just academics.</p>
                    </div>
                </div>

            </div>
        </div>
    </section>

    <!-- FINAL ASK - Hinglish -->
    <section class="py-24 bg-[#0F2A4A] text-white">
        <div class="max-w-4xl mx-auto px-6 text-center fade-in">
            <span class="text-6xl mb-6 block">🙏</span>
            <h2 class="heading-font text-4xl font-bold mb-6">हमारी आखिरी और सबसे बड़ी मांग</h2>
            <div class="text-2xl leading-relaxed max-w-3xl mx-auto text-amber-100">
                <p class="mb-8">"School management ji, hum students ko sirf padhne ke liye nahi, balki better insaan banne ke liye yahan aate hain. Humein ek aisa environment do jahan hum confidently padh sakein, khush reh sakein aur apne sapno ko pura kar sakein. Aapka saath hum hamesha yaad rakhenge."</p>
            </div>
            <p class="mt-10 text-[#E07A5F] text-xl font-medium">साथ मिलकर हम एक बेहतर स्कूल बना सकते हैं</p>
        </div>
    </section>

    <!-- CHARTER -->
    <section id="charter" class="py-28 section-peach">
        <div class="max-w-5xl mx-auto px-6">
            <div class="text-center mb-12 fade-in">
                <h2 class="heading-font text-5xl font-bold text-[#0F2A4A]">THE STUDENT CHARTER</h2>
                <p class="text-[#E07A5F] text-xl mt-3">अपनी आवाज़ जोड़ो • Add Your Name • Be Part of Change</p>
            </div>
            <iframe 
                src="https://docs.google.com/forms/d/e/1FAIpQLSdL5LvoKYs5LVtez5ktenSWubMgTlwbl0NS58--z53IFzGcRQ/viewform?usp=publish-editor" 
                width="100%" 
                height="880" 
                frameborder="0" 
                marginheight="0" 
                marginwidth="0">
                Loading...
            </iframe>
        </div>
    </section>

    <footer class="bg-[#0F2A4A] text-white/70 py-12 text-center text-sm">
        Sarla Chopra DAV Public School • Student Initiative 2026<br>
        <span class="text-amber-200">शांतिपूर्ण • सम्मानजनक • आशावान • एकजुट</span>
    </footer>

    <script>
        // Signature Count Animation
        let count = 26;
        const countEl = document.getElementById('count');
        countEl.textContent = count;

        // Accordion
        function toggleAccordion(el) {
            const parent = el.parentElement;
            parent.classList.toggle('accordion-open');
            const icon = el.querySelector('i');
            icon.style.transform = parent.classList.contains('accordion-open') ? 'rotate(180deg)' : 'rotate(0deg)';
        }

        // Fade-in on scroll
        function handleScroll() {
            document.querySelectorAll('.fade-in').forEach((el, index) => {
                const rect = el.getBoundingClientRect();
                if (rect.top < window.innerHeight * 0.85) {
                    el.classList.add('visible');
                }
            });
        }

        window.addEventListener('scroll', handleScroll);
        window.addEventListener('load', handleScroll);
    </script>
</body>
</html>
